# infra/.env 로 복사해서 사용한다. .env 는 커밋되지 않는다.
#   cp infra/.env.example infra/.env

# ── PostgreSQL ──────────────────────────────────────────────
DB_NAME=a107
DB_USER=a107
DB_PASSWORD=a107
DB_PORT=5432

# ── Redis ───────────────────────────────────────────────────
REDIS_PORT=6379

# ── Kafka ───────────────────────────────────────────────────
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Candle Sync ─────────────────────────────────────────────
CANDLE_SYNC_INTERVAL=5m
CANDLE_HISTORY_FROM=2025-01-01T00:00:00Z
CANDLE_HISTORY_REQUEST_BUDGET=240
UPBIT_REST_BASE_URL=https://api.upbit.com
UPBIT_REST_TIMEOUT=5s
